        "import hashlib, datetime, json, os\n",
        "os.makedirs(\"data/legal_registry\", exist_ok=True)\n",
        "\n",
        "def registrar_evento(tipo, descripcion, autor=\"Sistema\"):\n",
        "    \"\"\"\n",
        "    Registra un evento con fecha, tipo, descripción y autor\n",
        "    en un archivo de log JSON Lines.\n",
        "    \"\"\"\n",
        "    evento = {\n",
        "        \"fecha_utc\": datetime.datetime.utcnow().isoformat(),\n",
        "        \"tipo\": tipo,\n",
        "        \"descripcion\": descripcion,\n",
        "        \"autor\": autor,\n",
        "    }\n",
        "    try:\n",
        "        with open(\"data/legal_registry/event_log.jsonl\", \"a\") as f:\n",
        "            f.write(json.dumps(evento) + \"\\n\")\n",
        "    except Exception as e:\n",
        "        print(f\"Error al registrar evento: {e}\")\n",
        "\n",
        "def calcular_hash_documento(documento):\n",
        "    \"\"\"\n",
        "    Calcula un hash SHA-256 de un diccionario (documento).\n",
        "    Es crucial usar sort_keys=True para que el hash sea consistente.\n",
        "    \"\"\"\n",
        "    doc_string = json.dumps(documento, sort_keys=True).encode('utf-8')\n",
        "    return hashlib.sha256(doc_string).hexdigest()\n",
        "\n",
        "def generar_acta(path=\"data/legal_registry/event_log.jsonl\"):\n",
        "    \"\"\"\n",
        "    Calcula el hash de un archivo de log y guarda el resultado\n",
        "    como un acta legal inmutable.\n",
        "    \"\"\"\n",
        "    try:\n",
        "        # Abrir en modo binario ('rb') es crucial para un hash correcto\n",
        "        with open(path, \"rb\") as f:\n",
        "            contenido = f.read()\n",
        "\n",
        "        # 1. Calcular el hash del contenido\n",
        "        hash_result = hashlib.sha256(contenido).hexdigest()\n",
        "\n",
        "        # 2. Crear el diccionario del acta\n",
        "        acta = {\n",
        "            \"descripcion\": \"Acta de Cierre y Sellado de Log de Eventos\",\n",
        "            \"archivo_origen\": path,\n",
        "            \"fecha_sellado_utc\": datetime.datetime.utcnow().isoformat(),\n",
        "            \"hash_sha256\": hash_result\n",
        "        }\n",
        "\n",
        "        # 3. Guardar el acta como un nuevo archivo JSON\n",
        "        ruta_acta = \"data/legal_registry/acta_legal.json\"\n",
        "        with open(ruta_acta, \"w\") as f:\n",
        "            json.dump(acta, f, indent=2, ensure_ascii=False)\n",
        "\n",
        "        print(f\"Acta legal generada con éxito en: {ruta_acta}\")\n",
        "        print(f\"Hash del log (Sello): {hash_result}\")\n",
        "        return ruta_acta\n",
        "\n",
        "    except FileNotFoundError:\n",
        "        print(f\"Error: No se pudo encontrar el archivo de log en {path}\")\n",
        "        return None\n",
        "    except Exception as e:\n",
        "        print(f\"Ocurrió un error: {e}\")\n",
        "        return None\n",
        "\n",
        "def verificar_integridad(ruta_acta=\"data/legal_registry/acta_legal.json\", ruta_log=\"data/legal_registry/event_log.jsonl\"):\n",
        "    \"\"\"\n",
        "    Verifica la integridad del archivo de log comparando su hash actual\n",
        "    con el hash almacenado en el acta legal.\n",
        "    \"\"\"\n",
        "    try:\n",
        "        # 1. Leer el hash almacenado en el acta\n",
        "        with open(ruta_acta, \"r\") as f:\n",
        "            acta = json.load(f)\n",
        "        hash_almacenado = acta.get(\"hash_sha256\")\n",
        "\n",
        "        if not hash_almacenado:\n",
        "            print(f\"Error: No se encontró 'hash_sha256' en {ruta_acta}\")\n",
        "            return False\n",
        "\n",
        "        # 2. Leer el contenido del log y recalcular su hash\n",
        "        with open(ruta_log, \"rb\") as f:\n",
        "            contenido_log = f.read()\n",
        "\n",
        "        hash_recalculado = hashlib.sha256(contenido_log).hexdigest()\n",
        "\n",
        "        # 3. Comparar los hashes\n",
        "        print(f\"Hash Almacenado (Acta): {hash_almacenado}\")\n",
        "        print(f\"Hash Recalculado (Log): {hash_recalculado}\")\n",
        "\n",
        "        if hash_almacenado == hash_recalculado:\n",
        "            print(\"\\n✅ INTEGRIDAD VERIFICADA: El log no ha sido alterado.\")\n",
        "            return True\n",
        "        else:\n",
        "            print(\"\\n❌ ¡ALERTA! El log ha sido ALTERADO.\")\n",
        "            return False\n",
        "\n",
        "    except FileNotFoundError:\n",
        "        print(f\"Error: No se encontró el acta ({ruta_acta}) o el log ({ruta_log}).\")\n",
        "        return False\n",
        "    except Exception as e:\n",
        "        print(f\"Ocurrió un error durante la verificación: {e}\")\n",
        "        return False\n",
        "\n",
        "def generar_firma_educativa(autor, ruta_acta=\"data/legal_registry/acta_legal.json\"):\n",
        "    \"\"\"\n",
        "    Simula una firma digital combinando el hash del acta\n",
        "    con el nombre del autor y calculando un nuevo hash.\n",
        "    \"\"\"\n",
        "    try:\n",
        "        # 1. Leer el hash del acta (el sello del documento)\n",
        "        with open(ruta_acta, \"r\") as f:\n",
        "            acta = json.load(f)\n",
        "        hash_del_acta = acta.get(\"hash_sha256\")\n",
        "\n",
        "        if not hash_del_acta:\n",
        "            print(f\"Error: No se encontró 'hash_sha256' en {ruta_acta}\")\n",
        "            return None\n",
        "\n",
        "        # 2. Preparar los datos para la firma\n",
        "        # En un sistema real, el autor usaría su clave privada.\n",
        "        # Aquí, simulamos la vinculación combinando el hash + el nombre.\n",
        "        datos_para_firmar = f\"{hash_del_acta}:{autor}\"\n",
        "        print(f\"Datos combinados (Acta+Autor): {datos_para_firmar}\")\n",
        "\n",
        "        # 3. Calcular el hash de la combinación\n",
        "        firma_hash = hashlib.sha256(datos_para_firmar.encode('utf-8')).hexdigest()\n",
        "\n",
        "        print(f\"\\n--- Firma Digital Educativa Generada ---\")\n",
        "        print(f\"Autor (Firmante): {autor}\")\n",
        "        print(f\"Hash del Acta (Sello): {hash_del_acta}\")\n",
        "        print(f\"Firma (Hash combinado): {firma_hash}\")\n",
        "\n",
        "        # Guardamos la firma\n",
        "        firma_data = {\n",
        "            \"descripcion\": \"Simulación de Firma Digital sobre Acta Legal\",\n",
        "            \"autor_firmante\": autor,\n",
        "            \"hash_del_acta_firmada\": hash_del_acta,\n",
        "            \"firma_simulada\": firma_hash,\n",
        "            \"fecha_firma_utc\": datetime.datetime.utcnow().isoformat()\n",
        "        }\n",
        "\n",
        "        ruta_firma = \"data/legal_registry/firma_acta.json\"\n",
        "        with open(ruta_firma, \"w\") as f:\n",
        "            json.dump(firma_data, f, indent=2, ensure_ascii=False) # Added 'f' here\n",
        "\n",
        "        print(f\"Firma guardada en: {ruta_firma}\")\n",
        "        return firma_hash\n",
        "\n",
        "    except FileNotFoundError:\n",
        "        print(f\"Error: No se encontró el acta en {ruta_acta}.\")\n",
        "        return None\n",
        "    except Exception as e:\n",
        "        print(f\"Ocurrió un error al firmar: {e}\")\n",
        "        return None\n",
        "\n",
        "def resumen_eventos(path=\"data/legal_registry/event_log.jsonl\"):\n",
        "    \"\"\"\n",
        "    Lee el archivo de log (JSON Lines) y genera un resumen\n",
        "    de actividad, errores y el último autor.\n",
        "    \"\"\"\n",
        "    eventos = []\n",
        "\n",
        "    # --- 1. Leer el archivo de log ---\n",
        "    try:\n",
        "        with open(path, \"r\") as f:\n",
        "            for line in f:\n",
        "                try:\n",
        "                    eventos.append(json.loads(line))\n",
        "                except json.JSONDecodeError:\n",
        "                    print(f\"Advertencia: Se omitió una línea mal formada en {path}\")\n",
        "\n",
        "    except FileNotFoundError:\n",
        "        print(f\"Error: No se encontró el archivo de log en {path}\")\n",
        "        return\n",
        "    except Exception as e:\n",
        "        print(f\"Ocurrió un error al leer el archivo: {e}\")\n",
        "        return\n",
        "\n",
        "    if not eventos:\n",
        "        print(\"El archivo de log está vacío. No hay resumen que mostrar.\")\n",
        "        return\n",
        "\n",
        "    # --- 2. Procesar los eventos ---\n",
        "\n",
        "    # Usamos el campo 'tipo' para un conteo preciso\n",
        "    tipos = [e.get('tipo', 'INDEFINIDO').upper() for e in eventos]\n",
        "\n",
        "    num_errores = tipos.count('ERROR')\n",
        "    num_alertas = tipos.count('ALERTA_SEGURIDAD')\n",
        "    num_verificados = tipos.count('VERIFICACION')\n",
        "\n",
        "    # El último autor es el del último evento en la lista\n",
        "    ultimo_autor = eventos[-1].get('autor', 'Desconocido')\n",
        "\n",
        "    # --- 3. Generar el Resumen en Texto ---\n",
        "    print(\"--- Resumen de Trazabilidad del Log ---\")\n",
        "    print(f\"Total de eventos registrados: {len(eventos)}\")\n",
        "\n",
        "    print(\"\\n[Actividad del Sistema]\")\n",
        "    print(f\"· Verificaciones de integridad: {num_verificados}\")\n",
        "\n",
        "    print(\"\\n[Alertas y Errores]\")\n",
        "    print(f\"· Errores operativos: {num_errores}\")\n",
        "    print(f\"· Alertas de seguridad: {num_alertas}\")\n",
        "    print(f\"  TOTAL DE INCIDENCIAS: {num_errores + num_alertas}\")\n",
        "\n",
        "    print(\"\\n[Auditoría]\")\n",
        "    print(f\"· Última acción registrada por: {ultimo_autor}\")\n",
        "    print(\"---------------------------------------\")"
      ]
    },
